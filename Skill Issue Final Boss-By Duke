-- ============================================================
--  FPS — rolling 60-sample mean
-- ============================================================
local FPS = { v = 60, ft = 1/60, buf = {}, n = 0, cap = 60, last = 0 }
RunService.Heartbeat:Connect(function(dt)
    FPS.n = FPS.n + 1
    FPS.buf[((FPS.n-1) % FPS.cap) + 1] = dt
    local now = os.clock()
    if now - FPS.last < 0.20 then return end
    FPS.last = now
    local sum, cnt = 0, math.min(FPS.n, FPS.cap)
    for i = 1, cnt do sum = sum + (FPS.buf[i] or 0) end
    FPS.ft = sum / cnt
    FPS.v  = math.clamp(math.floor(1 / math.max(FPS.ft, 0.001)), 10, 500)
end)

-- ============================================================
--  PING — rolling 24-sample, EMA, variance
-- ============================================================
local Ping = { v=80, jit=0, ema=80, buf={}, n=0, cap=24, last=0 }
local function _pingUpdate()
    local now = os.clock()
    if now - Ping.last < 0.18 then return end
    Ping.last = now
    local ok, raw = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if not ok or not raw or raw <= 0 then return end
    Ping.n = Ping.n + 1
    Ping.buf[((Ping.n-1) % Ping.cap)+1] = raw
    Ping.ema = Ping.ema * 0.82 + raw * 0.18
    local cnt = math.min(Ping.n, Ping.cap)
    local s, s2 = 0, 0
    for i = 1, cnt do local x = Ping.buf[i] or 0; s=s+x; s2=s2+x*x end
    Ping.v   = s / cnt
    Ping.jit = math.sqrt(math.max(0, s2/cnt - (s/cnt)^2))
end
local function GetPing()   _pingUpdate(); return Ping.v   end
local function GetJitter() _pingUpdate(); return Ping.jit  end

-- ============================================================
--  CORE TIMING — everything derived from live FPS + Ping
-- ============================================================
local function PingLead()
    local p = GetPing(); local j = GetJitter()
    return math.clamp((p - 20) / 850 * 3.5, 0.003, 0.26)
         + math.clamp(j / 1600, 0, 0.032)
         + math.clamp(math.max(0, Ping.ema - p) / 1800, 0, 0.014)
end

local function TapDuration(urgency)
    local fps = math.max(FPS.v, 10)
    local p   = GetPing(); local j = GetJitter()

    local lo = math.clamp(0.022 - (fps - 30)/1800, 0.009, 0.022)
    local hi = math.clamp(0.055 + (p - 50)/1800 + j/2500, 0.030, 0.095)

    local scLo, scHi =
        (urgency == "ragdoll" or urgency == "prearm") and 0.52 or
        (urgency == "instant")                         and 0.62 or
        (urgency == "reactive")                        and 0.80 or 1.0,

        (urgency == "ragdoll" or urgency == "prearm") and 0.60 or
        (urgency == "instant")                         and 0.70 or
        (urgency == "reactive")                        and 0.86 or 1.0

    lo = lo * scLo; hi = hi * scHi
    return lo + (hi - lo) * math.random()
end

-- v11.2: taps per burst (tighter than v11.0, wider than v11.1)
local function BurstCount(heavy, urgency, cap)
    local n
    if urgency == "ragdoll" then
        n = math.random(5, 8)
    elseif urgency == "prearm" or urgency == "instant" then
        n = heavy and math.random(4, 7) or math.random(3, 5)
    elseif heavy then
        n = math.random(4, 6)
    else
        n = math.random(3, 5)
    end
    return math.min(n, cap or math.huge)
end

local function ReactDelay(heavy, urgency)
    local fps = FPS.v
    local fsc = math.clamp((fps - 30) / 140, 0, 0.50)

    if urgency == "prearm" then
        return math.clamp(0.004 + math.random() * 0.016, 0.004, 0.020)
    elseif urgency == "ragdoll" or urgency == "instant" then
        return math.clamp(0.006 + math.random() * 0.022, 0.006, 0.028)
    elseif urgency == "reactive" then
        return math.clamp(0.028 + math.random() * 0.034, 0.028, 0.062)
    elseif heavy then
        local lo = math.max(0.014, 0.036 * (1 - fsc))
        local hi = math.max(0.038, 0.075 * (1 - fsc * 0.5))
        return lo + math.random() * (hi - lo)
    else
        local lo = math.max(0.026, 0.065 * (1 - fsc * 0.5))
        local hi = math.max(0.062, 0.145 * (1 - fsc * 0.3))
        return lo + math.random() * (hi - lo)
    end
end

local function BurstCD(heavy)
    local p    = GetPing()
    local base = heavy and 0.075 or 0.100
    if p > 240 then return math.max(base * 0.20, base - 0.090)
    elseif p > 180 then return math.max(base * 0.32, base - 0.068)
    elseif p > 120 then return math.max(base * 0.48, base - 0.048)
    elseif p > 70  then return math.max(base * 0.68, base - 0.024) end
    return base
end

-- ============================================================
--  MATH UTILS
-- ============================================================
local TWO_PI = 2 * math.pi
local function gauss()
    return math.sqrt(-2 * math.log(math.max(1e-12, math.random())))
         * math.cos(TWO_PI * math.random())
end
local function gamma(k, th)
    k = math.max(k, 1.0)
    local d = k - 1/3; local c = 1/math.sqrt(9*d)
    while true do
        local x, v
        repeat x = gauss(); v = 1+c*x until v > 0
        v = v*v*v
        local u = math.max(1e-12, math.random())
        if u < 1 - 0.0331*x*x*x*x then return d*v*th end
        if math.log(u) < 0.5*x*x + d*(1-v+math.log(v)) then return d*v*th end
    end
end

-- ============================================================
--  ADAPTIVE LEAD — Thompson sampling over CFG.LeadSet
--  Tiap burst terprediksi milih satu lead. Hasilnya (parry sukses /
--  kena damage) dilaporin balik, jadi lead yang paling sering sukses
--  makin sering dipilih. Statistik diluruhkan pelan biar tetep adaptif.
-- ============================================================
local Lead = { a = {}, b = {}, n = 0 }
for i = 1, #CFG.LeadSet do Lead.a[i] = 1; Lead.b[i] = 1 end

local function betaSample(a, b)
    local x = gamma(math.max(a, 1), 1)
    local y = gamma(math.max(b, 1), 1)
    return x / (x + y)
end

function Lead:pick()
    local best, bi = -1, 1
    for i = 1, #CFG.LeadSet do
        local s = betaSample(self.a[i], self.b[i])
        if s > best then best, bi = s, i end
    end
    return bi, CFG.LeadSet[bi]
end

function Lead:report(i, ok)
    if not i or not self.a[i] then return end
    for j = 1, #CFG.LeadSet do
        self.a[j] = 1 + (self.a[j] - 1) * 0.985
        self.b[j] = 1 + (self.b[j] - 1) * 0.985
    end
    if ok then self.a[i] = self.a[i] + 1 else self.b[i] = self.b[i] + 1 end
    self.n = self.n + 1
end

-- ============================================================
--  RATE LIMITER — floor/ceil dari CFG, probe every 14s
-- ============================================================
local DynRL = { floor=CFG.RateFloor, ceil=CFG.RateCeil, cur=CFG.RateStart, probeT=0, pCd=14, hit=false, hb=false }
function DynRL:probe()
    local now = os.clock()
    if now - self.probeT < self.pCd then return end
    self.probeT = now
    if self.hb then self.cur=math.max(self.floor, self.cur-2); self.hb=false
    elseif self.hit then self.cur=math.max(self.floor, self.cur-1); self.hb=true
    else self.cur=math.min(self.ceil, self.cur+1) end
    self.hit = false
end
function DynRL:cap() self:probe(); return self.cur end

local RL = { t={} }
function RL:ok()
    local now=os.clock(); local f={}
    for _,x in ipairs(self.t) do if now-x<1 then f[#f+1]=x end end
    self.t=f
    local c=DynRL:cap(); if #self.t>=c then DynRL.hit=true end
    return #self.t < c
end
function RL:mark() self.t[#self.t+1]=os.clock() end
function RL:n() return #self.t end

