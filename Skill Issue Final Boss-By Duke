local function uiRoots()
    local r = {}
    if gethui then
        local ok, h = pcall(gethui)
        if ok and h then r[#r + 1] = h end
    end
    local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok2 and cg then r[#r + 1] = cg end
    r[#r + 1] = PGui
    return r
end

local function findByText(guiNames, pattern, class)
    for _, root in ipairs(uiRoots()) do
        local ok, kids = pcall(function() return root:GetChildren() end)
        if ok then
            for _, g in ipairs(kids) do
                if guiNames[g.Name] and g ~= sg then
                    local ok2, ds = pcall(function() return g:GetDescendants() end)
                    if ok2 then
                        for _, d in ipairs(ds) do
                            if d:IsA(class) then
                                local okT, t = pcall(function() return d.Text end)
                                if okT and type(t) == "string" and t:find(pattern) then
                                    return d, g
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return nil, nil
end

local function linkGym()
    if GY.btn and GY.btn.Parent then return end
    local b, g = findByText({ GymBotUI = true, TouchGui = true }, "^GYM BOT:", "TextButton")
    if b then
        GY.btn, GY.sg = b, g
        pcall(function() g.Enabled = false end)
    end
end

local LAG_NAMES = { "Nuke Texture", "Kill Shadow", "Kill Post FX", "Hide Leaves", "Kill FX",
    "Anchor Parts", "Kill Skybox", "Aggressive", "Adaptive FPS", "Auto Apply" }

local function linkLag()
    if LG.apply and LG.apply.Parent then return end
    local g = PGui:FindFirstChild("NonoAntiLag")
    if not g then return end
    LG.presets, LG.rows = {}, {}
    for _, d in ipairs(g:GetDescendants()) do
        if d:IsA("TextButton") then
            local t = d.Text
            if t:find("APPLY NUKE", 1, true) or t:find("RE-APPLY", 1, true) then
                LG.apply = d
            elseif t:find("RESTORE", 1, true) then
                LG.restore = d
            elseif t == "SAFE" or t == "BALANCED" or t == "MAX" then
                LG.presets[t] = d
            end
        elseif d:IsA("TextLabel") then
            for _, name in ipairs(LAG_NAMES) do
                if d.Text == name then
                    local row = d.Parent
                    local pill = row:FindFirstChildOfClass("Frame")
                    local b = row:FindFirstChildOfClass("TextButton")
                    if pill and b then LG.rows[name] = { btn = b, pill = pill } end
                end
            end
            if d.Text == "Render Distance" then
                for _, s in ipairs(d.Parent:GetChildren()) do
                    if s:IsA("TextLabel") and s ~= d then LG.dist = s end
                end
            end
        end
    end
    local main = g:FindFirstChild("Main")
    if main and LG.apply then
        LG.main = main
        main.Visible = false      -- bukan sg.Enabled, supaya RightControl asli gak munculin lagi
    end
end

local function linkParry()
    if PR.pc and PR.pc.Parent then return end
    local g = PGui:FindFirstChild("WRAITH_UI")
    if not g then return end
    for _, d in ipairs(g:GetDescendants()) do
        if d:IsA("TextButton") then
            local t = d.Text
            if t == "◈" then PR.pill = d
            elseif t:find("^PARRY") then PR.pc = d
            elseif t:find("^LOCK") then PR.lc = d end
        end
    end
    if not PR.pc then return end
    local panel = PR.pc.Parent
    for _, d in ipairs(panel:GetChildren()) do
        if d:IsA("TextLabel") then
            if d.Position.Y.Offset == 76 then PR.info = d
            elseif d.Position.Y.Offset == 90 then PR.sl = d end
        end
    end
    PR.sg = g
    -- panel asli cuma update teks pas Visible, jadi dibuka lewat klik pill-nya
    -- sendiri, lalu seluruh ScreenGui-nya disembunyikan
    if PR.pill and not panel.Visible then fire(PR.pill, "MouseButton1Click") end
    task.delay(0.5, function() pcall(function() g.Enabled = false end) end)
end

-- config table lewat getgc (cuma baca/tulis nilai, kode asli gak disentuh)
local function scanTables()
    if type(getgc) ~= "function" then return false end
    local ok, list = pcall(getgc, true)
    if not ok or type(list) ~= "table" then return false end
    for i, t in ipairs(list) do
        if type(t) == "table" then
            local okA, a = pcall(rawget, t, "PullLead")
            if okA and a ~= nil then
                local _, b = pcall(rawget, t, "StopOnMax")
                local _, c = pcall(rawget, t, "AutoLevel")
                if b ~= nil and c ~= nil then cfgGym[#cfgGym + 1] = t end
            else
                local okB, l = pcall(rawget, t, "LeadSet")
                if okB and l ~= nil then
                    local _, r = pcall(rawget, t, "RefreshMax")
                    if r ~= nil then cfgParry[#cfgParry + 1] = t end
                end
            end
        end
        if i % 4000 == 0 then task.wait() end
    end
    return true
end

local function cget(list, k) local t = list[#list]; if t then return t[k] end end
local function cset(list, k, v) for _, t in ipairs(list) do t[k] = v end end

-- FAST (ring): pola patch yang sama kayak script gym, tapi bisa dibalikin
local FAST_VALUES = { LeadIn = 0.25, GapMin = 0.15, GapMax = 0.30, CompleteHold = 1.0, MissCooldown = 0.3 }
local fastOn, fastBackup = false, nil
local function setFast(on)
    if type(getgc) ~= "function" then return false end
    local done = false
    pcall(function()
        for _, t in ipairs(getgc(true)) do
            if type(t) == "table" and rawget(t, "GymFolderName") and rawget(t, "LeadIn") then
                if on then
                    fastBackup = fastBackup or {}
                    for k, v in pairs(FAST_VALUES) do
                        if fastBackup[k] == nil then fastBackup[k] = rawget(t, k) end
                        t[k] = v
                    end
                elseif fastBackup then
                    for k, v in pairs(fastBackup) do t[k] = v end
                end
                done = true
                break
            end
        end
    end)
    return done
end

