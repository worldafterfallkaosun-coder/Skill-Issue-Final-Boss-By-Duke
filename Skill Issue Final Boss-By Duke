local function addSlider(parent, title, mn, mx, step, unit, get, set)
    divider(parent)
    local row = new("Frame", { Size = UDim2.new(1, 0, 0, 54), BackgroundTransparency = 1, LayoutOrder = nextLO() }, parent)
    label(row, title, 13, TH.bone, FB, { Position = UDim2.fromOffset(0, 8), Size = UDim2.new(0.68, 0, 0, 18) })
    local vl = label(row, "--", 12, TH.amb, FD, { Position = UDim2.new(0.68, 0, 0, 8), Size = UDim2.new(0.32, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Right })
    local trk = new("Frame", { Position = UDim2.fromOffset(0, 37), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = WHITE, BackgroundTransparency = 0.84, BorderSizePixel = 0 }, row)
    corner(trk, 3)
    local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0, BackgroundColor3 = TH.brand }, trk)
    corner(fill, 3); onTheme(function() fill.BackgroundColor3 = TH.brand end)
    local thumb = new("Frame", { Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3 }, trk)
    corner(thumb, 8)
    local hit = new("TextButton", { Size = UDim2.new(1, 0, 0, 32), Position = UDim2.fromOffset(0, 24), BackgroundTransparency = 1, Text = "",
        AutoButtonColor = false, ZIndex = 4 }, row)
    local dec = step >= 1 and 0 or #(tostring(step):match("%.(%d+)") or "")
    local fmt = "%." .. dec .. "f"
    local dragging, lastV = false, nil
    local function paint(v)
        local pct = math.clamp((v - mn) / (mx - mn), 0, 1)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        thumb.Position = UDim2.new(pct, 0, 0.5, 0)
        vl.Text = string.format(fmt, v) .. unit
    end
    local function fromX(x)
        local w = math.max(trk.AbsoluteSize.X, 1)
        local pct = math.clamp((x - trk.AbsolutePosition.X) / w, 0, 1)
        local v = mn + math.floor(pct * (mx - mn) / step + 0.5) * step
        return tonumber(string.format(fmt, math.clamp(v, mn, mx)))
    end
    hit.InputBegan:Connect(function(i)
        if not isPtr(i) then return end
        local pane = row:FindFirstAncestorOfClass("ScrollingFrame")
        if pane then pane.ScrollingEnabled = false end
        dragging = true
        lastV = fromX(i.Position.X); paint(lastV); set(lastV, false)
        DRAG = {
            move = function(p) lastV = fromX(p.X); paint(lastV); set(lastV, false) end,
            stop = function()
                dragging = false
                if pane then pane.ScrollingEnabled = true end
                set(lastV, true)
            end,
        }
    end)
    reg(function()
        if dragging then return end
        local v = get()
        if v then paint(v) else vl.Text = "--"; fill.Size = UDim2.new(0, 0, 1, 0); thumb.Position = UDim2.new(0, 0, 0.5, 0) end
    end)
end

local function addSeg(parent, labels, get, onPick)
