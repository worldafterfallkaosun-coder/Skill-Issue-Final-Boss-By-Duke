-- ============================================================
--  SPAM LOCK (dipertahankan buat kompatibilitas; DoBurst gak pakai lagi)
-- ============================================================
local spamLock=false; local spamLockT=0
local function ClearSL() spamLock=false; spamLockT=0 end

-- ============================================================
--  DO BURST (v13) — jadwalin jendela hold
--  Prediksi ada (hit-delay udah dipelajari):
--      mulai  = animStart + hitDelay - RTT - lead(Thompson)
--      selesai = animStart + hitDelay + HoldTail
--  Belum ada: mulai sekarang, tahan HoldUnknown/HoldHeavy/HoldRagdoll.
-- ============================================================
local function DoBurst(heavy, urg, track, ovr, name, t0)
    local isRDL = RDL.on or urg == "ragdoll"
    local now   = os.clock()
    local hd    = name and HD[name]
    local predicted = (not isRDL and hd and hd.n >= CFG.MinSamples and t0) and (t0 + hd.d) or nil
    HoldNote(name, heavy, urg, predicted ~= nil)

    local s, e
    if predicted then
        local leadV = 0.04
        local pend = PendFor(name, predicted)
        if pend then
            leadV = CFG.LeadSet[pend.i] or leadV
        else
            local li, lv = Lead:pick()
            leadV = lv
            PendAdd(li, predicted, name)
        end
        s = predicted - GetPing() / 1000 - leadV
        e = predicted + CFG.HoldTail
        Parry.nextFire = math.max(Parry.nextFire, now + CFG.RefireGap)
    else
        if not isRDL and CFG.EcoSkipLow then
            local ch = LP.Character
            local gv = ch and ch:GetAttribute("GuardValue")
            if typeof(gv) == "number" and gv < CFG.EcoGuardLow then
                ClearSL()
                return
            end
        end
        local dur = isRDL and CFG.HoldRagdoll or (heavy and CFG.HoldHeavy or CFG.HoldUnknown)
        s = now + 0.004
        e = s + dur
    end

    HoldRequest(math.max(s, now + 0.002), math.max(e, now + 0.05), (not predicted) and (not isRDL), predicted)
    if isRDL then task.delay(0.065, ClearSL) else ClearSL() end
end

-- ============================================================
--  CAN FIRE / FIRE PARRY
-- ============================================================
local function CanFire(ps, urg)
    local rdl=RDL.on
    if urg=="prearm" or urg=="ragdoll" or rdl then return not IsHardKO() end
    if urg=="instant" then
        if IsHardKO() then return false end
        return not spamLock or (os.clock()-spamLockT>0.32)
    end
    if urg=="reactive" then return MC.root~=nil and not IsSelfAtk() end
    if not Parry.on then return false end
    if Parry.firing and os.clock()-Parry.fireAt<CFG.RefireGap then return false end
    if os.clock()<Parry.nextFire then return false end
    if not MC.root then return false end
    if IsSelfAtk() then return false end
    if ps and os.clock()-ps.lastFireT<0.060 then return false end
    return true
end

local function FireParry(heavy, ps, urg, track, name, t0)
    local rdl=RDL.on or urg=="ragdoll"
    local fast=rdl or urg=="prearm"
    if fast then Parry.firing=false;Parry.fireAt=0;Parry.nextFire=0;spamLock=false;spamLockT=0 end
    if not fast and not CanFire(ps,urg) then return false end
    local cd=BurstCD(heavy)
    if urg~="reactive" and not fast then
        Parry.firing=true; Parry.fireAt=os.clock()
        Parry.nextFire=os.clock()+cd+gamma(1.2,0.004)
    end
    if ps then ps.lastFireT=os.clock() end
    local u=rdl and "ragdoll" or (urg or "normal")
    task.spawn(function()
        DoBurst(heavy, u, track, nil, name, t0)
        if urg~="reactive" and not rdl then task.wait(0.20); Parry.firing=false end
    end)
    return true
end

