local okStreak = 0
local function adaptiveStep()
    if not state.adaptive then tier = 0; return end
    -- Ambang turun 60% dari cap supaya cap rendah tidak memicu adaptive terus.
    local low  = math.min(CFG.fpsLowThreshold, fpsCapValue * 0.6)
    local good = math.min(50, fpsCapValue * 0.9)
    if currentFPS < low then
        okStreak = 0
        if tier < 2 then
            tier += 1
            log("adaptive T" .. tier .. ": dist " .. math.floor(userDist * TIER_DIST[tier + 1]))
            setStatus("● ADAPTIVE T" .. tier, AMBER)
        end
    elseif currentFPS >= good and tier > 0 then
        okStreak += 1
        if okStreak >= 2 then
            okStreak = 0
            tier -= 1
            log("adaptive T" .. tier .. ": pulih")
            setStatus(tier > 0 and "● ADAPTIVE T" .. tier or "● ACTIVE", tier > 0 and AMBER or GREEN)
        end
    else
        okStreak = 0
    end
end

local function applyGlobals()
    pset(rs, "QualityLevel", Enum.QualityLevel.Level01)
    if state.shadow then
        pset(Lighting, "GlobalShadows", false)
        pset(Lighting, "ShadowSoftness", 0)
        pset(Lighting, "EnvironmentDiffuseScale", 0)
        pset(Lighting, "EnvironmentSpecularScale", 0)
    end
    for _, v in ipairs(Lighting:GetChildren()) do
        if state.post and v:IsA("PostEffect") then
            pset(v, "Enabled", false)
        elseif state.post and v:IsA("Atmosphere") then
            for _, p in ipairs(ATMO_PROPS) do pset(v, p, 0) end
        elseif state.sky and v:IsA("Sky") then
            pcall(stash, v)
        end
    end
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if terrain and state.texture then
        for _, p in ipairs(WATER_PROPS) do pset(terrain, p, 0) end
        hset(terrain, "Decoration", false)
    end
end

