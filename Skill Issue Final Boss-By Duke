local function ready(m)
    if m.state == "ready" then return true end
    toast(m.label .. ": " .. (m.err or (m.state == "loading" and "masih memuat" or m.note)))
    return false
end
local function gymGet() if MOD.gym.state ~= "ready" then return nil end return optGet("gym", V.gym.on) end
local function warGet(k) if MOD.war.state ~= "ready" then return nil end return optGet(k, V.war[k]) end

local function setGym(v)
    if not ready(MOD.gym) then return end
    if gymGet() == v then return end
    fire(GY.btn, "Activated"); opt("gym", v)
    if v then V.gym.maxed = false end
    log("Gym bot " .. (v and "dinyalakan" or "dimatikan"))
end
local function setWar(k, v)
    if not ready(MOD.war) then return end
    if warGet(k) == v then return end
    fire(k == "parry" and WR.pc or WR.lc, "MouseButton1Click"); opt(k, v)
    log((k == "parry" and "Auto parry" or "Combat lock") .. (v and " dinyalakan" or " dimatikan"))
end
local function lagApply()
    local m = MOD.lag
    if m.state == "gone" or m.state == "missing" then
        LG.pending = true; loadMod("lag"); log("Anti-lag dimuat ulang"); return
    end
    if not ready(m) then return end
    if V.lag.running then return end
    fire(LG.apply, "MouseButton1Click")
    log("Anti-lag memproses objek…")
end
local function lagRestore()
    if MOD.lag.state ~= "ready" then return end
    if LG.restore then fire(LG.restore, "MouseButton1Click"); log("Anti-lag dipulihkan") end
end
local function lagUnload()
    if not ready(MOD.lag) then return end
    if LG.unload then fire(LG.unload, "MouseButton1Click"); log("Anti-lag dilepas"); toast("Anti-lag dilepas") end
end
local function lagPreset(name)
    if not ready(MOD.lag) then return end
    local b = LG.txt[name]
    if b then fire(b, "MouseButton1Click"); log("Preset " .. name .. " dipilih, tekan Terapkan") end
end
local function lagTgGet(name)
    if MOD.lag.state ~= "ready" then return nil end
    local t = LG.tg[name]
    if not t or not t.pill then return nil end
    return t.pill.BackgroundColor3.G > 0.5
end
local function lagTgFlip(name)
    if not ready(MOD.lag) then return end
    local t = LG.tg[name]
    if t and t.btn then fire(t.btn, "MouseButton1Click") end
end
local function lagSlGet(name)
    local s = LG.sl and LG.sl[name]
    if MOD.lag.state ~= "ready" or not s or not s.val then return nil end
    return tonumber(s.val.Text)
end
-- slider anti-lag: kirim input sentuh tiruan ke slider aslinya, lalu lepas lewat handler InputEnded milik Nono
local function lagSlSet(name, mn, mx, step, v, final)
    if MOD.lag.state ~= "ready" then return end
    local s = LG.sl[name]
    if not s or not s.track or not s.hit or not HAS.conn or #MOD.lag.ended == 0 then
        if final then toast("Slider anti-lag butuh executor dengan getconnections") end
        return
    end
    local now = os.clock()
    if not final and now - s.last < 0.12 then return end
    s.last = now
    local pct = math.clamp((v - mn + step * 0.25) / (mx - mn), 0, 1)
    local pos = Vector3.new(s.track.AbsolutePosition.X + pct * s.track.AbsoluteSize.X, s.track.AbsolutePosition.Y + 3, 0)
    local function fake(state)
        return { UserInputType = Enum.UserInputType.MouseButton1, UserInputState = state, Position = pos, KeyCode = Enum.KeyCode.Unknown }
    end
    pcall(function() for _, c in ipairs(getconnections(s.hit.InputBegan)) do c:Fire(fake(Enum.UserInputState.Begin)) end end)
    for _, c in ipairs(MOD.lag.ended) do pcall(function() c:Fire(fake(Enum.UserInputState.End)) end) end
end

local function cfgNote()
    toast("Opsi ini butuh executor dengan getgc dan modul yang aktif")
end
local function cbool(which, field)
    return function()
        local v = cget(which, field)
        if v == nil then return nil end
        return v and true or false
    end, function()
        local t = CFGT[which]
        if not t then cfgNote(); return end
        t[field] = not t[field]
    end
end
local function cnum(which, field)
    return function() return cget(which, field) end,
        function(v) local t = CFGT[which]; if t then t[field] = v end end
end

local function allOn() setGym(true); setWar("parry", true); setWar("lock", true); lagApply(); log("Semua sistem dinyalakan") end
local function allOff() setGym(false); setWar("parry", false); setWar("lock", false); lagRestore(); log("Semua sistem dimatikan") end

local function modNote(m)
    if m.state == "ready" then return "" end
    if m.state == "loading" then return "Memuat modul…" end
    if m.state == "gone" then return "Anti-lag dilepas. Tekan Terapkan untuk memuat ulang." end
    return m.err or m.note
end

