-- ============================================================
--  HOLD MANAGER (v13)
--  Satu block ditahan selama jendela hit, bukan tap-lepas-tap.
--  win = daftar {s=mulai, e=selesai} (os.clock). Loop per-frame
--  nahan/refresh block selama ada jendela aktif, lepas kalau habis.
-- ============================================================
local Hold = { win = {}, loop = false, down = false, lastTrue = 0, sent = 0, lastSent = 0, hist = {}, parryT = 0 }

local function HoldRelease()
    if not Hold.down then return end
    Hold.down = false
    Hold.lastSent = Hold.sent; Hold.sent = 0
    pcall(function() RequestBlock:FireServer(false) end)
end

local function HoldInterval()
    local cap = math.max(DynRL:cap(), 4)
    return math.max(0.040, 1 / (cap * 0.85))
end

local function HoldActive(now, gv)
    local act = false
    for k = #Hold.win, 1, -1 do
        local w = Hold.win[k]
        if now >= w.e or (w.u and CFG.EcoSkipLow and gv < CFG.EcoGuardLow) then
            table.remove(Hold.win, k)
        elseif now >= w.s then
            act = true
        end
    end
    return act
end

local function HoldSend()
    if CFG.RefreshMode == "cycle" and Hold.down then
        pcall(function()
            RequestBlock:FireServer(false)
            RequestBlock:FireServer(true)
        end)
        RL:mark(); RL:mark()
    else
        pcall(function() RequestBlock:FireServer(true) end)
        RL:mark()
    end
    local t = os.clock()
    Hold.lastTrue = t
    Hold.down = true
    Hold.sent = Hold.sent + 1
    for _, w in ipairs(Hold.win) do
        if t >= w.s then w.n = (w.n or 0) + 1 end
    end
end

-- true kalau perlu kirim: belum ada block turun, atau ada jendela aktif yang
-- jatah refresh-nya (RefreshMax) belum habis
local function HoldWants(now)
    if not Hold.down then return true end
    for _, w in ipairs(Hold.win) do
        local cap = (w.h and CFG.PredRefresh or CFG.RefreshMax) + 1
        if now >= w.s and now < w.e and (w.n or 0) < cap then return true end
    end
    return false
end

local function HoldLoop()
    if Hold.loop then return end
    Hold.loop = true
    task.spawn(function()
        while #Hold.win > 0 do
            if not (Parry.on or Parry.reactMode or RDL.on) then
                Hold.win = {}
                break
            end
            local now = os.clock()
            local char = LP.Character
            local gv = char and char:GetAttribute("GuardValue")
            if typeof(gv) ~= "number" then gv = 1 end
            local act = HoldActive(now, gv)
            local broken = char and char:GetAttribute("GuardBroken") == true
            if act and not broken then
                local gap = 0
                if Hold.down then gap = CFG.HoldRefresh and HoldInterval() or 9e9 end
                if now - Hold.lastTrue >= gap and HoldWants(now) and RL:ok() then
                    HoldSend()
                end
            elseif Hold.down and #Hold.win > 0 and not act then
                -- jeda antar dua jendela: lepas kalau jendela berikutnya masih jauh
                local nextS = math.huge
                for _, w in ipairs(Hold.win) do
                    if w.s < nextS then nextS = w.s end
                end
                if nextS - now > 0.20 then HoldRelease() end
            end
            task.wait()
        end
        HoldRelease()
        Hold.loop = false
    end)
end

local function HoldRequest(s, e, unk, hit)
    -- gabung ke jendela yang udah ada kalau itu hit/animasi yang sama
    for _, w in ipairs(Hold.win) do
        if hit and w.h then
            if math.abs(w.h - hit) < 0.05 then          -- hit yang sama, diminta ulang
                w.s = math.min(w.s, s); w.e = math.max(w.e, e)
                return
            end
        elseif (not hit) and (not w.h) and w.u == unk and s <= w.e and e >= w.s then
            w.s = math.min(w.s, s); w.e = math.max(w.e, e)   -- jendela tanpa timing yang overlap
            return
        end
    end
    Hold.win[#Hold.win + 1] = { s = s, e = e, u = unk, h = hit }
    HoldLoop()
end

-- parry sukses: buang jendela yang lagi aktif/sudah mulai, sisakan yang di masa depan
local function HoldParried()
    local now = os.clock()
    Hold.parryT = now
    for k = #Hold.win, 1, -1 do
        if Hold.win[k].s <= now + 0.05 then table.remove(Hold.win, k) end
    end
end

-- ============================================================
--  ATTACK TAG (v13.4) — catatan request parry terakhir buat guard log
-- ============================================================
local function HoldNote(name, heavy, urg, pred)
    local h = Hold.hist
    local nm = name or ("(" .. tostring(urg) .. ")")
    local last = h[#h]
    if last and last.n == nm and os.clock() - last.t < 0.25 then return end
    h[#h + 1] = { t = os.clock(), n = nm, H = heavy, p = pred }
    if #h > 8 then table.remove(h, 1) end
end

local function AtkTag()
    local now = os.clock()
    local out = {}
    for i = #Hold.hist, 1, -1 do
        local r = Hold.hist[i]
        local age = now - r.t
        if age > 1.0 or #out >= 3 then break end
        out[#out + 1] = string.format("%s|%s|%s|%.2fs",
            string.sub(tostring(r.n), 1, 24), r.H and "H" or "L", r.p and "pred" or "unk", age)
    end
    if #out == 0 then return "-" end
    return table.concat(out, " ; ")
end

-- ============================================================
--  GUARD LOG (v13.2) — print tiap GuardValue turun
-- ============================================================
local function GuardLogHook(char)
    if not CFG.GuardLog or not char then return end
    local last = char:GetAttribute("GuardValue")
    if typeof(last) ~= "number" then last = 1 end
    char:GetAttributeChangedSignal("GuardValue"):Connect(function()
        local v = char:GetAttribute("GuardValue")
        if typeof(v) ~= "number" then return end
        if v < last - 0.005 then
            local t0, from, to = os.clock(), last, v
            local hold, sent, prev, win, atk = Hold.down, Hold.sent, Hold.lastSent, #Hold.win, AtkTag()
            task.delay(0.15, function()
                local kind = (math.abs(Hold.parryT - t0) <= 0.15) and "parry" or "other"
                print(string.format("[GUARD] %.2f -> %.2f (-%.2f) %s | hold=%s sends=%d prev=%d win=%d | atk=%s",
                    from, to, from - to, kind, tostring(hold), sent, prev, win, atk))
            end)
        end
        last = v
    end)
end
