-- ====================================================================
local function runSource(name, src)
    if type(loadstring) ~= "function" then notify("Executor gak punya loadstring"); return end
    task.spawn(function()
        local fn, err = loadstring(src, "=" .. name)
        if not fn then
            warn("[SIFB] " .. name .. " gagal dikompilasi: " .. tostring(err))
            notify(name .. " gagal dimuat")
            return
        end
        local ok, e = pcall(fn)
        if not ok then warn("[SIFB] " .. name .. " error: " .. tostring(e)) end
    end)
end

