--  HOOK SELF
-- ============================================================
local function HookSelf(char)
    if not char then return end
    local hum=char:FindFirstChildWhichIsA("Humanoid")

    -- my swings: attributes
    for _,a in ipairs(SELF_ATKS) do
        pcall(function()
            char:GetAttributeChangedSignal(a):Connect(function()
                if char:GetAttribute(a)==true then MarkCombat(); MarkSwing() end
            end)
        end)
    end
    -- my swings: animations (fallback when attributes don't exist)
    if hum then
        local function hookAnim(an)
            pcall(function()
                an.AnimationPlayed:Connect(function(track)
                    local ok,n=pcall(function() return track.Animation.Name end)
                    if ok and n and not isReactAnim(n) and (isM1(n) or isM2(n)) then MarkSwing() end
                end)
            end)
        end
        local an=hum:FindFirstChildOfClass("Animator")
        if an then hookAnim(an)
        else hum.ChildAdded:Connect(function(c) if c:IsA("Animator") then hookAnim(c) end end) end
    end

    for _,a in ipairs(KO_ATTRS) do
        pcall(function()
            char:GetAttributeChangedSignal(a):Connect(function()
                if char:GetAttribute(a)==true then
                    Lock.target=nil; Lock.inCombat=false
                    DestroyCon(); Parry.nextFire=0; Parry.firing=false; ClearSL()
                end
            end)
        end)
    end

    if hum then
        hum.Died:Connect(function() FullOff() end)

        -- ragdoll detection (parry only; NEVER locks)
        local rdlCd=0
        hum:GetPropertyChangedSignal("FloorMaterial"):Connect(function()
            local now=os.clock()
            if hum.FloorMaterial==Enum.Material.Air then
                task.delay(0.032,function()
                    local root=MC.root; if not root then return end
                    local v=root.Velocity; local c=MC.char
                    local bh=c and (c:GetAttribute("IsBeingCarried")==true or c:GetAttribute("IsBeingFinished")==true)
                    if (v.Y>8 or v.Y< -4 or bh) and now>rdlCd then
                        rdlCd=now+0.18; SetRDL(true)
                        if Parry.on then FQ:push("ragdoll",false,nil) end
                    end
                end)
            else task.delay(0.065,function() SetRDL(false) end) end
        end)

        -- HIT-IN: HP dropped AND a real attacker identified -> lock + learn timing
        local prevHP=hum.Health
        hum:GetPropertyChangedSignal("Health"):Connect(function()
            local cur=hum.Health
            local drop=prevHP-cur
            prevHP=cur
            if drop < 0.5 then return end
            MarkCombat(); PendFail()
            local t=FindAttacker()
            if t then
                local ps=GPS(t.UserId)
                if ps.animName and not ps.animHit then
                    ps.animHit=true
                    LearnDelay(ps.animName, os.clock()-ps.animT)
                end
                CL:onIncoming(t)
            end
        end)
    end
end

