-- ============================================================
--  OUTCOME TRACKING — feeds the adaptive lead
--  Pending = burst terprediksi yang nunggu hasil (ParryFX / HP drop)
-- ============================================================
local Pend, Stat, _lastFailT = {}, {ok=0, fail=0}, 0
local function PendAdd(i, H, name) Pend[#Pend+1] = {i=i, H=H, name=name} end
local function PendFor(name, H)
    for _, p in ipairs(Pend) do
        if p.name == name and math.abs(p.H - H) < 0.20 then return p end
    end
    return nil
end
local function PendResolve(ok)
    local now = os.clock()
    for k = #Pend, 1, -1 do if now - Pend[k].H > 0.8 then table.remove(Pend, k) end end
    local bk, bd = nil, 0.50
    for k, p in ipairs(Pend) do
        local d = math.abs(now - p.H)
        if d < bd then bd, bk = d, k end
    end
    if not bk then return end
    local p = table.remove(Pend, bk)
    Lead:report(p.i, ok)
    if ok then Stat.ok = Stat.ok + 1 else Stat.fail = Stat.fail + 1 end
    _dirty = true
    if Lead.n % 10 == 0 then
        local bi, bm = 1, -1
        for i = 1, #CFG.LeadSet do
            local m = Lead.a[i] / (Lead.a[i] + Lead.b[i])
            if m > bm then bm, bi = m, i end
        end
        print(string.format("[WRAITH] %d hasil | sukses %d / gagal %d | lead terbaik %.2fs (%.0f%%)",
            Lead.n, Stat.ok, Stat.fail, CFG.LeadSet[bi], bm * 100))
    end
end
local function PendFail()
    local now = os.clock()
    if now - _lastFailT < 0.15 then return end
    _lastFailT = now
    PendResolve(false)
end

