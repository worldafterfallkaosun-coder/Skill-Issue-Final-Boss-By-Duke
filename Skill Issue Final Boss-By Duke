local function startDrag(obj, input, onTap)
    local sx, sy = input.Position.X, input.Position.Y
    local ox, oy = obj.Position.X.Offset, obj.Position.Y.Offset
    local moved = false
    DRAG = {
        move = function(p)
            local dx, dy = p.X - sx, p.Y - sy
            if not moved and math.abs(dx) + math.abs(dy) < 8 then return end
            moved = true
            clampTo(obj, ox + dx, oy + dy)
        end,
        stop = function() if not moved and onTap then onTap() end end,
    }
end
