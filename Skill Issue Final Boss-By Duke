local function beginDrag(handle, target, onTap)
    handle.InputBegan:Connect(function(i)
        if isPointer(i) and not activeSlider then
            drag = { target = target, start = i.Position, origin = target.Position, moved = false, onTap = onTap }
        end
    end)
end
beginDrag(header, panel, nil)
beginDrag(launcher, launcher, function() setOpen(not isOpen) end)

track(UIS.InputChanged:Connect(function(i)
    local t = i.UserInputType
    if t ~= Enum.UserInputType.MouseMovement and t ~= Enum.UserInputType.Touch then return end
    if activeSlider then activeSlider.move(i.Position.X); return end
    if not drag then return end
    local d = i.Position - drag.start
    if not drag.moved and (math.abs(d.X) > 6 or math.abs(d.Y) > 6) then drag.moved = true end
    if drag.moved then
        local c = workspace.CurrentCamera
        local v = (c and c.ViewportSize) or Vector2.new(844, 390)
        local sz = drag.target.AbsoluteSize
        local x = math.clamp(drag.origin.X.Offset + d.X, 0, math.max(0, v.X - sz.X))
        local y = math.clamp(drag.origin.Y.Offset + d.Y, 0, math.max(0, v.Y - sz.Y))
        drag.target.Position = UDim2.fromOffset(x, y)
    end
end))
track(UIS.InputEnded:Connect(function(i)
    if not isPointer(i) then return end
    if drag then
        local dg = drag
        drag = nil
        if not dg.moved and dg.onTap then dg.onTap() end
    end
    if activeSlider then
        activeSlider.page.ScrollingEnabled = true
        activeSlider = nil
    end
end))
track(UIS.InputBegan:Connect(function(i, gp)
    if not gp and i.KeyCode == Enum.KeyCode.Insert then setOpen(not isOpen) end
end))

