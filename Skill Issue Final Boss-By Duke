local env = (getgenv and getgenv()) or _G
if env.__GYMBOT_STOP then pcall(env.__GYMBOT_STOP) end

local alive   = true
local conns   = {}
local enabled = true
local sg

local function track(c) conns[#conns + 1] = c; return c end
env.__GYMBOT_STOP = function()
    alive = false
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    if sg then pcall(function() sg:Destroy() end) end
end

local function notify(text)
    pcall(function()
        StarterGui:SetCore("SendNotification", { Title = "Gym Bot", Text = text, Duration = 4 })
    end)
    print("[GymBot] " .. text)
end

-- ---------- helper: trigger signal tanpa input asli ----------
local function fire(inst, sigName)
    local sig = inst[sigName or "Activated"]
    if firesignal then
        local ok = pcall(firesignal, sig)
        if ok then return true end
    end
    if getconnections then
        local ok = pcall(function()
            for _, c in ipairs(getconnections(sig)) do c:Fire() end
        end)
        if ok then return true end
    end
    return false
end

-- ---------- helper: "klik" tombol minigame (PullUp / TreadMill) ----------
-- Handler tombol mereka dengerin InputBegan dan cuma baca .UserInputType,
-- jadi input palsu berisi tabel kecil udah cukup. Kalau getconnections
-- gak ada, jatuh ke keyboard virtual (F / J / Space).
local FAKE_INPUT = { UserInputType = Enum.UserInputType.Touch, UserInputState = Enum.UserInputState.Begin }
local usedMethod

local function pressGui(btn, key)
