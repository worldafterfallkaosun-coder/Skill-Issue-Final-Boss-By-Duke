-- ============================================================
--  LOCK IMPLEMENTATION
-- ============================================================
local function LockBlocked()
    local c=LP.Character; if not c then return true end
    for _,s in ipairs(KO_ATTRS) do if c:GetAttribute(s)==true then return true end end
    return false
end
local function ValidTgt(t)
    if not t or not t.Parent then return false end
    local c=t.Character; if not c then return false end
    local h=c:FindFirstChild("Humanoid"); if not h or h.Health<=0 then return false end
    local r=c:FindFirstChild("HumanoidRootPart"); if not r then return false end
    return MC.root and Dist(MC.root,r)<=LCFG.Leash
end
local function DestroyCon()
    pcall(function() if Lock.alignOri then Lock.alignOri:Destroy();Lock.alignOri=nil end end)
    pcall(function() if Lock.att0 then Lock.att0:Destroy();Lock.att0=nil end end)
end
local function SetupCon()
    local root=MC.root; if not root then return end
    if Lock.alignOri and Lock.alignOri.Parent==root then return end
    DestroyCon()
    local att=Instance.new("Attachment"); att.Name=ATT_NAME; att.Parent=root; Lock.att0=att
    local ao=Instance.new("AlignOrientation")
    ao.Name=AO_NAME; ao.Mode=Enum.OrientationAlignmentMode.OneAttachment
    ao.Attachment0=att; ao.MaxTorque=LCFG.MaxTorque; ao.MaxAngularVelocity=math.huge
    ao.Responsiveness=LCFG.Resp; ao.RigidityEnabled=false; ao.PrimaryAxisOnly=false
    ao.Parent=root; Lock.alignOri=ao
end
local function UpdVel(pos)
    local now=os.clock(); local dt=now-Lock.velT
    if Lock.prevPos and dt>0 and dt<0.3 then
        local rv=(pos-Lock.prevPos)/dt
        local alpha=math.clamp(0.38-(GetPing()-80)/2000,0.10,0.55)
        Lock.vel=Lock.vel:Lerp(rv,alpha)
    end
    Lock.prevPos=pos; Lock.velT=now
end
local function SetAim(pos)
    if not Lock.alignOri or LockBlocked() then return end
    local root=MC.root; if not root then return end
    local dir=pos-root.Position; dir=Vector3.new(dir.X,dir.Y*0.10,dir.Z)
    if dir.Magnitude<0.05 then return end
    dir=dir.Unit; local up=Vector3.new(0,1,0)
    local right=dir:Cross(up); if right.Magnitude<0.01 then return end
    right=right.Unit; Lock.alignOri.CFrame=CFrame.fromMatrix(Vector3.zero,right,right:Cross(dir).Unit)
end

GetBest = function(rescan)
    local root=MC.root; if not root then return nil end
    if not rescan and Lock.target and ValidTgt(Lock.target) then return Lock.target end
    local best,bestEff=nil,-1
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LP then
            local c=p.Character; if not c then continue end
            local r=c:FindFirstChild("HumanoidRootPart")
            local h=c:FindFirstChild("Humanoid")
            if not r or not h or h.Health<=0 then continue end
            local d=Dist(root,r)
            if d<=LCFG.Range then
                local sc,_=Score(p,GPS(p.UserId))
                local eff=sc-d*0.12
                if eff>bestEff then bestEff=eff; best=p end
            end
        end
    end
    return best
end

-- UnlockTarget = neutral (target nil, Lock.on unchanged)
UnlockTarget = function()
    Lock.target=nil; Lock.prevPos=nil; Lock.vel=Vector3.zero
    DestroyCon()
end

FullOff = function()
    Lock.on=false; Lock.target=nil; Lock.inCombat=false; Lock.combatT=0
    Lock.prevPos=nil; Lock.vel=Vector3.zero; Lock.isAtk=false
    DestroyCon(); Parry.nextFire=0; Parry.firing=false; ClearSL()
end

-- THE ONLY FUNCTION THAT SETS Lock.target. Snaps aim immediately.
LockOn = function(t)
    if not t or not Lock.on or not CL.active then return end
    local isNew = t ~= Lock.target
    Lock.target = t; Lock.expT = os.clock() + EXCHANGE_TTL + 0.3
    if isNew then Lock.prevPos=nil; Lock.vel=Vector3.zero end
    SetupCon()
    local er = t.Character and t.Character:FindFirstChild("HumanoidRootPart")
    if er then SetAim(er.Position + Vector3.new(0,1.5,0)) end
    MarkCombat()
end

-- ============================================================
--  LOCK HEARTBEAT — aim + expiry only
-- ============================================================
RunService.Heartbeat:Connect(function(dt)
    if os.clock()-Lock.combatT>5.0 then Lock.inCombat=false end
    if not Lock.on then return end

    if not CL.active then
        if Lock.target then UnlockTarget() end
        return
    end

    if Lock.target and os.clock()>Lock.expT then UnlockTarget(); return end
    if Lock.target and not ValidTgt(Lock.target) then UnlockTarget(); return end

    if not Lock.target then return end

    local ec=Lock.target.Character; if not ec then return end
    local er=ec:FindFirstChild("HumanoidRootPart"); if not er then return end
    UpdVel(er.Position)
    local ap=er.Position+Lock.vel*LCFG.Pred
    SetAim(Vector3.new(ap.X, ap.Y+1.5, ap.Z))
end)

