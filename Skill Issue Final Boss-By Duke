-- ============================================================
--  LEARNED HIT DELAY (per animation name)
--  HD[name] = {d = ema of (hit time - anim start), n = samples}
--  Fed by: my HP drops (failed/no parry) and ParryFX (success).
-- ============================================================
local HD = {}
local _dirty = false
local function LearnDelay(name, obs)
    if not name or not obs or obs < 0.03 or obs > 0.90 then return end
    local e = HD[name]
    if not e then
        HD[name] = {d = obs, n = 1}
    else
        if e.n >= 3 and math.abs(obs - e.d) > 0.22 then return end -- outlier (combo chain etc.)
        if e.n < 3 and math.abs(obs - e.d) > 0.40 then return end
        local w = (e.n < 3) and 0.50 or 0.35
        e.d = e.d * (1 - w) + obs * w
        e.n = math.min(e.n + 1, 50)
    end
    _dirty = true
end

