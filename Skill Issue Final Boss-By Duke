-- "klik" tombol script asli tanpa input asli
local function fire(inst, sigName)
    local ok0, sig = pcall(function() return inst[sigName] end)
    if not ok0 then return false end
    if getconnections then
        local ok = pcall(function()
            for _, c in ipairs(getconnections(sig)) do c:Fire() end
        end)
        if ok then return true end
    end
    if firesignal then
        if pcall(firesignal, sig) then return true end
    end
    return false
end

