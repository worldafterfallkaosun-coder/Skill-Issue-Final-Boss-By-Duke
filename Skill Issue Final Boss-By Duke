--  FIRE QUEUE — priority sorted
-- ============================================================
local FQ = {q={}, last=0, gap=0.016}
local PRI = {prearm=6, ragdoll=5, instant=4, reactive=3, combo=3, normal=2, idle=1}

function FQ:push(urg, heavy, track, name, t0)
    local now=os.clock()
    for _,e in ipairs(self.q) do
        if e.urg==urg and now-e.t < 0.022 then return end
    end
    self.q[#self.q+1]={urg=urg, heavy=heavy, track=track, name=name, t0=t0, t=now, pri=PRI[urg] or 1}
    table.sort(self.q, function(a,b) return a.pri>b.pri end)
end

function FQ:pop()
    local now=os.clock(); local f={}
    for _,e in ipairs(self.q) do
        local ttl=(e.urg=="prearm") and 0.080 or 0.170
        if now-e.t < ttl then f[#f+1]=e end
    end
    self.q=f
    if #self.q==0 then return nil end
    local e=self.q[1]; table.remove(self.q,1); return e
end

