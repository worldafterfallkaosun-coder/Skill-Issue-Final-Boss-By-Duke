local function segmented(parent, opts, get, set)
    local r = hrow(parent, 38)
    local btns = {}
    for i, o in ipairs(opts) do
        local b = new("TextButton", { Text = tostring(o), Font = FB, TextSize = 12, TextColor3 = WHITE,
            BackgroundColor3 = WHITE, BackgroundTransparency = 0.92, BorderSizePixel = 0, Size = cell(#opts),
            LayoutOrder = i }, r)
        corner(b, 9)
        btns[i] = b
    end
    local function refresh()
        local cur = get()
        for i, b in ipairs(btns) do
            local on = (cur == opts[i])
            b.BackgroundColor3 = on and ACCENT or WHITE
            b.BackgroundTransparency = on and 0.1 or 0.92
        end
    end
    for i, b in ipairs(btns) do
        b.Activated:Connect(function() set(opts[i]); refresh() end)
    end
    onRefresh(refresh)
end

local function slider(parent, page, label, minV, maxV, step, get, set)
    local c = card(parent, 54)
    text(c, label, 12, TXT, { Size = UDim2.new(0.6, 0, 0, 16), Position = UDim2.fromOffset(12, 8) })
    local val = text(c, "", 12, WHITE, { Font = FB, Size = UDim2.new(0.4, -12, 0, 16), Position = UDim2.new(0.6, 0, 0, 8),
        TextXAlignment = RIGHT })
    local trk = new("Frame", { Size = UDim2.new(1, -24, 0, 6), Position = UDim2.fromOffset(12, 36),
        BackgroundColor3 = OFFC, BorderSizePixel = 0 }, c)
    corner(trk, 3)
    local fill = new("Frame", { BackgroundColor3 = ACCENT, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0) }, trk)
    corner(fill, 3)
    local thumb = new("Frame", { Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3 }, trk)
    corner(thumb, 8)
    local hit = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30),
        Position = UDim2.new(0, 0, 0.5, -15), ZIndex = 4 }, trk)
    local function show(v)
        local pct = (v - minV) / (maxV - minV)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        thumb.Position = UDim2.new(pct, 0, 0.5, 0)
        val.Text = tostring(v)
    end
    local s = { page = page }
    function s.move(x)
        local w = math.max(trk.AbsoluteSize.X, 1)
        local raw = minV + math.clamp((x - trk.AbsolutePosition.X) / w, 0, 1) * (maxV - minV)
        local v = math.clamp(minV + math.floor((raw - minV) / step + 0.5) * step, minV, maxV)
        show(v)
        set(v)
    end
    hit.InputBegan:Connect(function(i)
        if isPointer(i) then
            activeSlider = s
            page.ScrollingEnabled = false
            s.move(i.Position.X)
        end
    end)
    onRefresh(function()
        local v = get()
        if v then show(math.clamp(v, minV, maxV)) end
    end)
end

