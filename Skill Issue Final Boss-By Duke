local function processObject(obj)
    local cls = obj.ClassName
    if cls == "Terrain" then return end
    if obj:IsA("BasePart") then return processPart(obj) end
    if cls == "Humanoid" then
        if obj.Parent ~= lp.Character and not touchedHum[obj] then
            touchedHum[obj] = true
            for _, s in ipairs(HUM_STATES) do obj:SetStateEnabled(s, false) end
