-- pembaruan optimistis biar tombol terasa langsung (teks asli baru update ~0.25 dtk kemudian)
local OPT = {}
local function opt(k, v) OPT[k] = { v = v, t = os.clock() } end
local function optGet(k, real)
    local o = OPT[k]
    if o and os.clock() - o.t < 0.8 then return o.v end
    return real
end

local function snap(sig)
    local t = {}
    if not HAS.conn then return nil end
    pcall(function() for _, c in ipairs(getconnections(sig)) do local f = c.Function; if f then t[f] = true end end end)
    return t
end
local function diff(sig, before)
    local out = {}
    if not before then return out end
    pcall(function()
        for _, c in ipairs(getconnections(sig)) do
            local f = c.Function
            if f and not before[f] then out[#out + 1] = c end
        end
    end)
    return out
end

