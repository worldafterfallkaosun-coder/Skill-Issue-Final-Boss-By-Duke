-- ============================================================
local _qcT=0
local function ConsumeQ()
    local now=os.clock(); if now-_qcT<FQ.gap then return end; _qcT=now
    local e=FQ:pop(); if not e then return end
    FireParry(e.heavy, nil, e.urg, e.track, e.name, e.t0)
end

-- ============================================================
--  COMBO / HISTORY
-- ============================================================
local function RecordHit(ps, heavy, src)
    local now=os.clock()
    ps.history[#ps.history+1]={t=now,h=heavy,s=src}
    if #ps.history>32 then table.remove(ps.history,1) end
    ps.lastHitT=now
    if #ps.history>=3 then
        local s,n=0,0
        for i=2,#ps.history do s=s+ps.history[i].t-ps.history[i-1].t;n=n+1 end
        ps.avgIv=s/n
    else ps.avgIv=nil end
end
local function UpdateCombo(ps,uid,heavy,src)
    if os.clock()-ps.lastHitT>1.5 then ps.combo=0 end
    RecordHit(ps,heavy,src); ps.combo=ps.combo+1; return ps.combo
end
local function UpdateThr(missed,ps)
    Parry.dynThr=Parry.dynThr*0.80+(missed and 3 or 8)*0.20
    Parry.dynThr=math.clamp(Parry.dynThr,3,10)
    if missed then
        Parry.consecMiss=Parry.consecMiss+1; Parry.missStreak=Parry.missStreak+1
        if ps then ps.missStreak=(ps.missStreak or 0)+1 end
        if Parry.consecMiss>=3 then ClearSL();Parry.consecMiss=0;Parry.missStreak=0;Parry.nextFire=0 end
    else Parry.consecMiss=0;Parry.missStreak=0; if ps then ps.missStreak=0 end end
end

-- ============================================================
--  PRE-ARM TRIGGER
-- ============================================================
local function TryPreArm(ps, uid, animName, heavy, t0)
    if not heavy and not isM1(animName) then return end
    local now=os.clock()
    if ps.preArmActive and now<ps.preArmExp then return end
    ps.preArmActive=true; ps.preArmExp=now+0.55
    FQ:push(heavy and "prearm" or "instant", heavy, nil, animName, t0)
end

-- ============================================================
--  HEARTBEAT — parry scan (never touches the lock)
--  v11.2: only players with attack evidence are considered
-- ============================================================
local _hbT=0
RunService.Heartbeat:Connect(function()
    CL:tick(); MaybeRotate(); PollRDL()
    if Parry.on or Parry.reactMode or RDL.on then ConsumeQ() end
    local parryOn=Parry.on or Parry.reactMode
    if not parryOn then Decoy:tick(); return end
    local rdl=RDL.on
    if not rdl and not MC.root then RefreshChar(); return end
    if not rdl and IsSelfAtk() then return end
    local now=os.clock()
    local sr=rdl and 0.001 or math.max(0.002, FPS.ft*0.80)
    if now-_hbT<sr then return end; _hbT=now

    if not Parry.on then return end
    if not rdl and now<Parry.nextFire then return end

    local q={}
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LP then
            local ps2=GPS(p.UserId)
            if HasEvidence(p, ps2, now) then
                local sc,hv=Score(p,ps2)
                if sc>=Parry.dynThr then q[#q+1]={p=p,sc=sc,hv=hv,ps=ps2} end
            end
        end
    end
    table.sort(q,function(a,b) return a.sc>b.sc end)

    if #q>0 then
        local top=q[1]; local ps2=top.ps; local uid=top.p.UserId
        if top.hv then ps2.heavyAlert=true; ps2.heavyAlertExp=now+4.0 end
        local u=rdl and "ragdoll" or "normal"
        local nm, t0 = nil, nil
        if ps2.animName and now-ps2.animT < 0.9 then nm, t0 = ps2.animName, ps2.animT end
        local fired=FireParry(top.hv, ps2, u, nil, nm, t0)
        if fired then UpdateCombo(ps2,uid,top.hv,"HB"); UpdateThr(false,ps2) end
    end
end)

-- ============================================================
--  WATCH CHAR — anim + attr listeners
-- ============================================================
local function WatchChar(p, char)
    if not char then return end
    local eh=char:FindFirstChildWhichIsA("Humanoid")
    local uid=p.UserId; local ps=GPS(uid)

    local function watchAnim(anim)
        pcall(function()
            anim.AnimationPlayed:Connect(function(track)
                if not track then return end
                local ok,n=pcall(function() return track.Animation.Name end)
                if not ok or not n then return end
                if isReactAnim(n) then return end
                local aid=""
                pcall(function() aid=tostring(track.Animation.AnimationId):match("%d+") or "" end)
                local key=(aid~="") and (n.."#"..aid) or n
                local H=isM2(n); local M=isM1(n)
                local isAct=false
                pcall(function() isAct = (ACT_PRI[track.Priority]==true) and (not track.Looped) end)
                if not H and not M and not isAct then return end

                -- attack evidence (before parry gates, so lock attribution works with parry off)
                local gps=GPS(uid)
                local now=os.clock()
                gps.atkT=now; gps.animName=key; gps.animT=now; gps.animHit=false

                if not (Parry.on or Parry.reactMode) then return end
                if not RDL.on and IsSelfAtk() then return end
                local er=char:FindFirstChild("HumanoidRootPart")
                if not er or not MC.root then return end
                if Dist(MC.root,er)>26 or FromBack(er) then return end
                local ck=uid.."_"..n
                if now-(ps.lastAnimFire[ck] or 0)<0.075 then return end
                ps.lastAnimFire[ck]=now

                UpdateCombo(ps,uid,H,n)
                if H then ps.heavyAlert=true; ps.heavyAlertExp=now+4.0 end

                -- learned timing available -> single timed burst
                local hd=HD[key]
                if hd and hd.n>=CFG.MinSamples then
                    FQ:push(RDL.on and "ragdoll" or "prearm", H, track, key, now)
                    return
                end

                -- default path (no timing data yet)
                if track.TimePosition<=0.020 then TryPreArm(ps,uid,n,H,now) end
                if H then
                    FQ:push(RDL.on and "ragdoll" or "instant", true, nil, key, now)
                else
                    FQ:push(RDL.on and "ragdoll" or "normal", false, track, key, now)
                end
            end)
        end)
    end

    local function onAttr(obj, a)
        pcall(function()
            obj:GetAttributeChangedSignal(a):Connect(function()
                local v=obj:GetAttribute(a)
                if not (v==true or (type(v)=="string" and (v:lower():find("attack") or v:lower():find("heavy")))) then return end
                if a~="FightMode" and a~="IsStartingBattle" then GPS(uid).atkT=os.clock() end
                if not (Parry.on or Parry.reactMode) then return end
                if not RDL.on and IsSelfAtk() then return end
                local er=char:FindFirstChild("HumanoidRootPart")
                if not er or not MC.root then return end
                if Dist(MC.root,er)>26 or FromBack(er) then return end
                local hvy=isHeavyAttr(a)
                local now=os.clock()
                if now-ps.lastFireT<0.060 then return end
                if hvy then
                    ps.heavyAlert=true; ps.heavyAlertExp=now+4.0
                    ps.preArmActive=true; ps.preArmExp=now+0.55
                    if not ps.m2Det or now>=ps.m2DetExp then
                        ps.m2Det=true; ps.m2DetExp=now+2.5
                        UpdateCombo(ps,uid,true,a)
                        FQ:push(RDL.on and "ragdoll" or "prearm", true, nil)
                        return
                    end
                end
                UpdateCombo(ps,uid,hvy,a)
                FQ:push(RDL.on and "ragdoll" or "normal", hvy, nil)
            end)
        end)
    end

    if eh then
        local an=eh:FindFirstChildOfClass("Animator")
        if an then watchAnim(an)
        else eh.ChildAdded:Connect(function(c) if c:IsA("Animator") then watchAnim(c) end end) end
    end
    for _,a in ipairs(ALL_ATTR) do
        onAttr(char,a); if eh then onAttr(eh,a) end
    end

    -- HIT-OUT: lock ONLY when this enemy's HP dropped inside my swing window
    if eh then
        local ph = eh.Health
        eh:GetPropertyChangedSignal("Health"):Connect(function()
            local h = eh.Health
            local drop = ph - h
            ph = h
            if drop < 0.5 then return end
            if CFG.LearnFromOthers then pcall(LearnFromVictim, p, char) end
            if os.clock() - lastSelfAtkT > 0.60 + GetPing()/1000 then return end
            local er = char:FindFirstChild("HumanoidRootPart")
            if not er or not MC.root then return end
            if Dist(MC.root, er) > LCFG.HitRange or FromBack(er) then return end
            CL:onOutgoing(p)
        end)
    end
end

