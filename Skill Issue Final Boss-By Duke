local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function text(parent, str, size, color, props)
    local t = {
        Text = str, Font = FR, TextSize = size, TextColor3 = color,
        BackgroundTransparency = 1, TextXAlignment = LEFT,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }
    for k, v in pairs(props or {}) do t[k] = v end
    return new("TextLabel", t, parent)
end
local orderN = 0
local function ord() orderN = orderN + 1; return orderN end
