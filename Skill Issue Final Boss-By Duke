-- ---------- Anti-lag (Nono) ----------
local LAG_TOGGLES = { "Nuke Texture", "Kill Shadow", "Kill Post FX", "Hide Leaves", "Kill FX",
    "Anchor Parts", "Kill Skybox", "Aggressive", "Adaptive FPS", "Auto Apply" }

local function sib(lbl)
    if not lbl or not lbl.Parent then return nil end
    for _, c in ipairs(lbl.Parent:GetChildren()) do
        if c:IsA("TextLabel") and c ~= lbl then return c end
    end
end

local function attachLag()
    local sg = PGui:FindFirstChild("NonoAntiLag")
    local main = sg and sg:FindFirstChild("Main")
    local wrap = main and main:FindFirstChild("BodyWrapper")
    local scroll = wrap and wrap:FindFirstChild("Scroll")
    if not scroll then return false end
    local txt = {}
    for _, d in ipairs(scroll:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" and not txt[d.Text] then txt[d.Text] = d end
    end
    local apply = scroll:FindFirstChildWhichIsA("TextButton")
    if not (apply and txt["STATUS"] and txt["BEFORE"]) then return false end
    LG.sg, LG.main, LG.scroll, LG.apply, LG.txt = sg, main, scroll, apply, txt
    LG.status, LG.hidden = sib(txt["STATUS"]), sib(txt["Hidden"])
    LG.before, LG.after = sib(txt["BEFORE"]), sib(txt["AFTER"])
    LG.restore, LG.unload, LG.logLbl = nil, nil, nil
    for text, inst in pairs(txt) do
        if inst:IsA("TextButton") then
            if text:find("RESTORE", 1, true) then LG.restore = inst
            elseif text:find("UNLOAD", 1, true) then LG.unload = inst end
        end
    end
    for _, c in ipairs(scroll:GetChildren()) do
        if c:IsA("TextLabel") and c.BackgroundColor3 == Color3.fromRGB(8, 8, 8) then LG.logLbl = c end
    end
    LG.tg = {}
    for _, name in ipairs(LAG_TOGGLES) do
        local l = txt[name]
        if l then
            LG.tg[name] = { btn = l.Parent:FindFirstChildWhichIsA("TextButton"), pill = l.Parent:FindFirstChildWhichIsA("Frame") }
        end
    end
    LG.sl = {}
    for _, name in ipairs({ "FPS Cap (bypass)", "Render Distance" }) do
        local l = txt[name]
        if l then
            local top = l.Parent
            local frame = top.Parent
            local trk, hit
            for _, c in ipairs(frame:GetChildren()) do
                if c:IsA("Frame") and c ~= top then trk = c end
            end
            if trk then
                for _, c in ipairs(trk:GetChildren()) do
                    if c:IsA("TextButton") and c.Size.X.Scale == 1 then hit = c end
                end
            end
            LG.sl[name] = { track = trk, hit = hit, val = sib(l), last = 0 }
        end
    end
    return true
end

local function pollLag()
    local m = MOD.lag
    if m.state == "gone" then return end
    if m.state ~= "ready" then
        if attachLag() then
            m.state, m.err = "ready", nil
            log("Anti-lag terhubung")
            if LG.pending then LG.pending = nil; fire(LG.apply, "MouseButton1Click") end
        elseif os.clock() - m.t0 > m.wait and m.state == "loading" then
            m.state = "missing"
        end
        return
    end
    if not LG.sg or not LG.sg.Parent then m.state = "gone"; return end
    -- disembunyikan dengan digeser keluar layar (layout tetap valid buat slider)
    if not LG.sg.Enabled then LG.sg.Enabled = true end
    if LG.main.Position.X.Offset ~= -10000 then LG.main.Position = UDim2.new(0, -10000, 0, 0) end
    local st = LG.status and LG.status.Text or ""
    V.lag.statusTxt = st
    V.lag.running = (st:find("RUNNING", 1, true) or st:find("RESTORING", 1, true)) and true or false
    V.lag.applied = LG.apply.Text:find("RE-APPLY", 1, true) ~= nil
    local a, b = (LG.logLbl and LG.logLbl.Text or ""):match("nuking (%d+)/(%d+)")
    if V.lag.running then
        V.lag.prog = (a and tonumber(b) and tonumber(b) > 0) and math.floor(tonumber(a) / tonumber(b) * 100) or 60
    else
        V.lag.prog = V.lag.applied and 100 or 0
    end
    local bn = LG.before and LG.before.Text:match("(%d+) fps")
    local an = LG.after and LG.after.Text:match("(%d+) fps")
    V.lag.before = bn and tonumber(bn) or nil
    V.lag.after = an and tonumber(an) or nil
    V.lag.hidden = tonumber((LG.hidden and LG.hidden.Text or ""):match("(%d+)")) or 0
end

local function pollSys()
    local ok, ping = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    V.sys.ping = ok and ping or 0
    local ok2, mem = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
    V.sys.mem = ok2 and mem or 0
end

